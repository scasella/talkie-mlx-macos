# Optional Hugging Face token for faster or authenticated model downloads.
# Never commit a real token.
HF_TOKEN=

# Optional override for where scripts/download_model.sh installs Python + model files.
# Default: ~/Library/Application Support/Talkie Cabinet
TALKIE_CABINET_HOME=

# Optional runtime overrides. The app auto-detects these under TALKIE_CABINET_HOME.
TALKIE_MLX_PYTHON=
TALKIE_MLX_MODEL=

# Optional notarization settings for scripts/package_dmg.sh --notarize.
# Prefer NOTARYTOOL_PROFILE after storing credentials with:
# xcrun notarytool store-credentials <profile-name>
NOTARYTOOL_PROFILE=
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_SPECIFIC_PASSWORD=
